<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phones: "New on PHOENIXA" notifications when titles are added to your server -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV / Google TV: lets PHOENIXA put your unfinished titles in the home screen's "Continue watching" row -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Phones: downloading movies and episodes for offline viewing keeps going in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.software.leanback" android:required="${leanbackRequired}" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Works in any orientation (the screens turn themselves as needed), so no device is excluded -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".NovaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:banner="@drawable/banner_phoenixa"
        android:icon="@mipmap/ic_phoenixa"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Nova"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/banner_phoenixa"
            android:icon="@mipmap/ic_phoenixa"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="sensorLandscape" />

        <!-- Offline downloads run as a "data sync" background task with a progress notification -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- "New on PHOENIXA" push notifications (sent by the server through Firebase) -->
        <service
            android:name=".notify.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
